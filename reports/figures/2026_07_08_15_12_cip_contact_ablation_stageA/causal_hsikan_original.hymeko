CoinHsikanOriginal{}
coinhsikanoriginal
{
    progress_score {}
    approach_score {}
    contact_score {}
    delivery_score {}
    anti_exploit_score {}
    total_reward {}

    @c0{ (+anti_exploit_score, +approach_score); }
    @c1{ (+anti_exploit_score, +contact_score); }
    @c2{ (+progress_score, +delivery_score); }
    @c3{ (+contact_score, +total_reward); }
}
