MetaWorldCoffeePushReal{}
metaworldcoffeepushreal
{
    progress_score {}
    action_noise {}
    near_fraction {}
    total_reward {}

    @c0{ (+near_fraction, +progress_score); }
    @c1{ (+near_fraction, +action_noise); }
    @c2{ (+total_reward, -action_noise); }
    @c3{ (+near_fraction, +total_reward); }
}
