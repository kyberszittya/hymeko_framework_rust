<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="{{config:world_name}}">
{{#each cameras}}
    <model name="{{name}}">
      <static>true</static>
      <pose>{{field:position}} 0 0 0</pose>
      <!-- look_at: {{field:target}} -->
      <link name="link">
        <sensor name="{{name}}_sensor" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>{{field:fov}}</horizontal_fov>
          </camera>
        </sensor>
      </link>
    </model>
{{/each}}
  </world>
</sdf>
