// DOT traceability graph, generated by HyMeKo for {{config:robot_name}}.
// Requirements (left) → realized/derived/allocated by components (right).
// Render: dot -Tpdf traceability_smc.dot -o traceability_smc.pdf
digraph {{config:robot_name}} {
  rankdir=LR;
  fontname="sans-serif";
  node [fontname="sans-serif", fontsize=10];
  edge [fontname="sans-serif", fontsize=9];

  // Requirements
  node [shape=box, style="rounded,filled", fillcolor="#fde68a"];
{{#each requirements}}
  "{{name}}" [label="<<requirement>>\n{{name}}"];
{{/each}}

  // Components
  node [shape=component, style=filled, fillcolor="#bfdbfe"];
{{#each blocks}}
  "{{name}}" [label="<<block>>\n{{name}}"];
{{/each}}

  // Satisfy: component -> requirement
  edge [color="#16a34a", fontcolor="#16a34a", style=dashed];
{{#each satisfies_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<satisfy>>"];
{{/each}}

  // Allocate: requirement -> component
  edge [color="#db2777", fontcolor="#db2777", style=solid];
{{#each allocated_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<allocate>>"];
{{/each}}

  // Derive: derived requirement -> source requirement
  edge [color="#7c3aed", fontcolor="#7c3aed", style=dotted];
{{#each derives_edges}}
  "{{bind:+:0}}" -> "{{bind:-:0}}" [label="<<deriveReqt>>"];
{{/each}}
}
