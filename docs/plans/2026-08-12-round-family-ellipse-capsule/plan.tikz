% plan.tikz — the round family (ellipse + capsule/stadium) vs the corner family, and why flat mesh not native.
\documentclass[tikz,border=8pt]{standalone}
\usetikzlibrary{arrows.meta,positioning,fit,backgrounds,shapes.geometric}
\begin{document}
\begin{tikzpicture}[
  font=\small,
  box/.style={draw,rounded corners,align=center,minimum height=8mm,inner sep=4pt},
  new/.style={box,fill=green!12,draw=green!55!black,thick},
  keep/.style={box,fill=blue!7,draw=blue!45},
  bad/.style={box,fill=red!8,draw=red!50},
  flow/.style={-{Stealth[length=3mm]},thick},
]
% two axes of shape space
\node[keep] (poly) {corner family (N-gon)\\triangle $\to$ pentagon $\to$ hexagon};
\node[new,below=8mm of poly] (round) {\textbf{round family (this plan)}\\ellipse (O3-E) + capsule/stadium (O9-K)};
\node[keep,right=14mm of poly] (coin) {coin (cylinder)\\the shared limit};
\draw[flow,gray] (poly) -- node[above,font=\scriptsize]{$n\to\infty$} (coin);
\draw[flow,gray] (round) -- node[below,font=\scriptsize]{eccentricity $\to 0$} (coin);

% the native-vs-mesh decision
\node[bad,below=10mm of round] (native) {native ellipsoid / capsule\\bulge in $z$ $\Rightarrow$ wrong volume\\NO mass parity (0.033/0.034 vs 0.050)};
\node[new,right=10mm of native] (mesh) {flat MESH prism\\smooth boundary extruded\\mass $=$ O0 ($\Delta<2\!\times\!10^{-5}$)};
\draw[flow] (native) -- node[above,font=\scriptsize]{rejected} (mesh);
\draw[flow] (round) -- (mesh);

% shape insets
\begin{scope}[shift={(8.2,-2.2)}]
  \draw[green!55!black,thick,rotate=0] (0,0) ellipse (0.9 and 0.55);
  \node[font=\scriptsize,align=center] at (0,-1.0) {O3-E ellipse\\25.0mm};
\end{scope}
\begin{scope}[shift={(8.2,-4.2)}]
  \draw[green!55!black,thick] (-0.55,-0.35) -- (0.55,-0.35) arc (-90:90:0.35) -- (-0.55,0.35) arc (90:270:0.35);
  \node[font=\scriptsize,align=center] at (0,-0.95) {O9-K capsule\\26.5mm};
\end{scope}

\begin{scope}[on background layer]
  \node[draw=green!45!black,dashed,rounded corners,fit=(round)(native)(mesh),inner sep=7pt,
        label=below:{reuse radius/radius\_y (no new kwarg); no existing branch touched}] {};
\end{scope}
\end{tikzpicture}
\end{document}
