// DOT traceability graph, generated by HyMeKo for pick_place_cell.
// Requirements (left) → realized/derived/allocated by components (right).
// Render: dot -Tpdf traceability_smc.dot -o traceability_smc.pdf
digraph pick_place_cell {
  rankdir=LR;
  fontname="sans-serif";
  node [fontname="sans-serif", fontsize=10];
  edge [fontname="sans-serif", fontsize=9];

  // Requirements
  node [shape=box, style="rounded,filled", fillcolor="#fde68a"];

  "R1_safe_stop" [label="<<requirement>>\nR1_safe_stop"];

  "R2_pos_accuracy" [label="<<requirement>>\nR2_pos_accuracy"];

  "R3_cycle_time" [label="<<requirement>>\nR3_cycle_time"];

  "R2a_repeatability" [label="<<requirement>>\nR2a_repeatability"];


  // Components
  node [shape=component, style=filled, fillcolor="#bfdbfe"];

  "SafetyController" [label="<<block>>\nSafetyController"];

  "MotionPlanner" [label="<<block>>\nMotionPlanner"];

  "Arm" [label="<<block>>\nArm"];

  "Gripper" [label="<<block>>\nGripper"];


  // Satisfy: component -> requirement
  edge [color="#16a34a", fontcolor="#16a34a", style=dashed];

  "SafetyController" -> "R1_safe_stop" [label="<<satisfy>>"];

  "MotionPlanner" -> "R2_pos_accuracy" [label="<<satisfy>>"];

  "Arm" -> "R2_pos_accuracy" [label="<<satisfy>>"];

  "MotionPlanner" -> "R3_cycle_time" [label="<<satisfy>>"];

  "Gripper" -> "R3_cycle_time" [label="<<satisfy>>"];


  // Allocate: requirement -> component
  edge [color="#db2777", fontcolor="#db2777", style=solid];

  "R2a_repeatability" -> "Arm" [label="<<allocate>>"];


  // Derive: derived requirement -> source requirement
  edge [color="#7c3aed", fontcolor="#7c3aed", style=dotted];

  "R2a_repeatability" -> "R2_pos_accuracy" [label="<<deriveReqt>>"];

}
