// gripper.hymeko — a parallel-jaw gripper on a 3-DOF gantry base, described in HyMeKo.
//
//   world -[slide_x]-> carriage_x -[slide_y]-> carriage_y -[slide_z]-> palm
//     palm -[grip_l]-> finger_l ;  palm -[grip_r]-> finger_r
//
// One source -> the MJCF scene AND the kinematic hypergraph (carriages, palm, two fingers) that the
// HSiKAN actor/critic message-passes over — same as every other scenario. The env (PickPlaceEnv) injects
// the table, the freejoint object, and the place target (the gripper itself is fully HyMeKo, like the
// arms/quadruped). Prismatic base + branching fingers — both already supported by the emitter
// (cart-pole rail + quadruped legs). Validates via `hymeko validate`.

gripper_description {
    @"meta_kinematics.hymeko";
}

gripper: meta_kinematics.kinematics.elements, meta_kinematics.kinematics.geometry, meta_kinematics.kinematics.axes
{
    world: meta_kinematics.kinematics.elements.frame {}

    base_color   [0.25, 0.35, 0.80, 1.0];
    finger_color [0.85, 0.45, 0.20, 1.0];

    // gantry carriages (small; they carry the base DOF), the palm, and two fingers.
    carriage_x: meta_kinematics.kinematics.elements.link {
        mass 0.10;
        link_geometry: meta_kinematics.kinematics.geometry.box { dimension [0.04, 0.04, 0.02]; }
        visual -> link_geometry; collision -> link_geometry; color -> gripper.base_color; origin [0.0, 0.0, 0.0];
    }
    carriage_y: meta_kinematics.kinematics.elements.link {
        mass 0.10;
        link_geometry: meta_kinematics.kinematics.geometry.box { dimension [0.04, 0.04, 0.02]; }
        visual -> link_geometry; collision -> link_geometry; color -> gripper.base_color; origin [0.0, 0.0, 0.0];
    }
    palm: meta_kinematics.kinematics.elements.link {
        mass 0.20;
        link_geometry: meta_kinematics.kinematics.geometry.box { dimension [0.10, 0.05, 0.024]; }
        visual -> link_geometry; collision -> link_geometry; color -> gripper.base_color; origin [0.0, 0.0, 0.0];
    }
    finger_l: meta_kinematics.kinematics.elements.link {
        mass 0.02;
        link_geometry: meta_kinematics.kinematics.geometry.box { dimension [0.012, 0.036, 0.06]; }
        visual -> link_geometry; collision -> link_geometry; color -> gripper.finger_color; origin [0.0, 0.0, -0.03];
    }
    finger_r: meta_kinematics.kinematics.elements.link {
        mass 0.02;
        link_geometry: meta_kinematics.kinematics.geometry.box { dimension [0.012, 0.036, 0.06]; }
        visual -> link_geometry; collision -> link_geometry; color -> gripper.finger_color; origin [0.0, 0.0, -0.03];
    }

    // === Gantry base: three prismatic joints (X, Y, Z), rest height 0.22 m. ===
    @slide_x: meta_kinematics.kinematics.prismatic_joint {
        (+ world [[0.0, 0.0, 0.22], [0.0, 0.0, 0.0]], - carriage_x,
         - meta_kinematics.kinematics.axes.AXIS_X);
    }
    @slide_y: meta_kinematics.kinematics.prismatic_joint {
        (+ carriage_x, - carriage_y, - meta_kinematics.kinematics.axes.AXIS_Y);
    }
    @slide_z: meta_kinematics.kinematics.prismatic_joint {
        (+ carriage_y, - palm, - meta_kinematics.kinematics.axes.AXIS_Z);
    }

    // === Fingers: prismatic along X off the palm; the env drives them oppositely to grasp. ===
    @grip_l: meta_kinematics.kinematics.prismatic_joint {
        (+ palm [[-0.035, 0.0, -0.012], [0.0, 0.0, 0.0]], - finger_l,
         - meta_kinematics.kinematics.axes.AXIS_X);
    }
    @grip_r: meta_kinematics.kinematics.prismatic_joint {
        (+ palm [[0.035, 0.0, -0.012], [0.0, 0.0, 0.0]], - finger_r,
         - meta_kinematics.kinematics.axes.AXIS_X);
    }
}
