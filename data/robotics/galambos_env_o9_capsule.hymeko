// galambos_env_o9_capsule.hymeko — OBJ_O9-K: the STADIUM / capsule-profile SHAPE ablation (Track A2 round family).
//
// Identical Galambos scene/task to galambos_env.hymeko; ONLY the manipulated object differs. O9-K is a flat
// STADIUM (discorectangle) prism — the planar analogue of a capsule: a rectangle with two semicircular caps.
// radius = half-length a = 0.026533, radius_y = cap radius b = 0.013266 (aspect a/b = 2.0). Equal projected area
// to the reference disk (4·(a−b)·b + π·b² = π·0.02²) and same thickness ⇒ mass = O0, friction unchanged.
// `compose_planar_scene`'s "capsule" branch builds a flat mesh prism (48 arc segments/cap) — a native MuJoCo
// `capsule` bulges in z ⇒ different volume ⇒ no mass parity, so the flat stadium prism is used instead.
//
// Distinct from the ellipse: FLAT parallel sides + round ends (a stable clamp with rounded caps). Track A2, 2026-08-12.

galambos_env_description {
    @"meta_env.hymeko";
    using env.params as p;
    using env        as e;
}

galambos_env: p, e
{
    @zone:   p.target_zone { half 0.04; rx_lo -0.05; rx_hi 0.05; ry_lo 0.10; ry_hi 0.18; randomize 1.0; }
    @spawn:  p.coin_spawn  { rx_lo -0.20; rx_hi 0.20; ry_lo 0.05; ry_hi 0.23; clearance 0.03; }
    @bounds: p.workspace   { x_bound 0.40; y_min -0.08; y_max 0.45; }
    @succ:   p.success     { steps 5.0; }

    // O9-K: flat stadium prism, half-length a=0.026533 / cap radius b=0.013266 (aspect 2.0), equal area ⇒ mass = O0.
    @dsk:    p.disk        { shape "capsule"; family "prism_stadium"; radius 0.026533; radius_y 0.013266; half 0.02; damping 2.5; spin_damping 0.8; frictionloss 0.0; }

    @env_spec: e.env_spec {
        (+ zone, + spawn, + bounds, + succ, + dsk);
    }
}
