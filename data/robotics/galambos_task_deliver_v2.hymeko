// galambos_task_deliver_v2.hymeko — DELIVERY-DOMINANT reward for the v2 (physically-real contact) env.
//
// Identical to galambos_task_deliver.hymeko, plus ONE term that expresses the graded contact-quality
// preference of the v2 env (galambos_env_v2.hymeko):
//   + armbodycoin <w>  — a per-step penalty while a NON-FINGERTIP arm link touches the coin.
//
// This is the reward side of the graded model (Hajdu 2026-07-06): arm-body↔coin contact is physically
// allowed but NON-PREFERRED, so it costs. A sustained body *shove* (an exploit) accumulates a strong
// penalty across its many contact steps; an incidental graze costs little; a clean fingertip delivery pays
// nothing. The fingertip grasp is NOT penalised. The eval separately grades each delivery clean / assisted /
// exploit by progress attribution, so the reward and the metric agree on preferring clean fingertip delivery.
//
// WEIGHT IS A SEED, not a hand-tuned final value (as in deliver.hymeko): before any RL run on this reward,
// re-run reward_oracle.certify and the reward-shape optimisation — a penalty term can, if too large, suppress
// the approach the way whole-arm `arm_collision` at 2.0 did (0.615->0.0, 2026-06-28). Only the scripted
// baseline (which ignores the reward) has been validated against it so far.

galambos_task_description {
    @"meta_kinematics.hymeko";
    @"meta_reward.hymeko";
    using kinematics.elements as el;
    using reward.terms        as rew;
    using reward              as r;
}

galambos_task_deliver_v2: el, rew, r
{
    disk:        el.frame {}
    target_zone: el.frame {}

    // Term nodes — typed reward signals (no weights here; the bundle's arcs carry them).
    @approach:        rew.grasp_approach {}
    @bothapproach:    rew.both_approach  {}   // dense coordination gradient (-max(l,r)); NOT a farmable annuity
    @pull:            rew.reach_distance { (+ disk, - target_zone); }
    @zoneprog:        rew.zone_progress  {}   // target-direction gradient: PBRS Phi=-disk_to_zone (farm-proof)
    @both:            rew.both_contact   {}
    @zone:            rew.in_zone        {}
    @graspzone:       rew.grasp_deliver  {}
    @terminaldeliver: rew.terminal_deliver {}   // the one-shot anti-farming delivery bonus
    @center:          rew.center_bonus   {}
    @explore:         rew.arm_motion     {}
    @noclash:         rew.arm_collision  {}
    @nofinger:        rew.fingers_collision {}
    @oob:             rew.out_of_bounds  {}
    @armcol:          rew.arm_body_collision {}
    @armbodycoin:     rew.arm_body_coin_contact {}   // v2 graded: penalise a non-fingertip arm link on the coin
    @fingertouch:     rew.finger_contact {}
    @settle:          rew.settle              {}
    @stillcoin:       rew.coin_pregrasp_still {}
    @timecost:        rew.time_penalty       {}
    @smoothv:         rew.joint_velocity     {}
    @smootha:         rew.joint_acceleration {}

    // ORACLE-CERTIFIED DELIVERING shape (from deliver.hymeko) + the v2 graded arm-body penalty (armbodycoin).
    @grasp_reward: r.reward_spec {
        (+ approach 4.0, + bothapproach 4.0, + oob 2.0, + terminaldeliver 30.0, + zoneprog 10.0,
         + armbodycoin 2.0);
    }
}
