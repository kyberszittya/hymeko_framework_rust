// coin_carry_option_v1.hymeko — the CARRY OPTION as a declarative FSM (the thing that actually runs).
//
// This is the executable automaton for the strict-0 carry option that precedes the frozen settling skill:
//   PUSH -> BRAKE -> RELEASE -> (HANDOFF | COMPLETED | ABORTED)
// and after a valid handoff (strict>=1) the FROZEN settling pi_0 carries the episode to DELIVERED / SETTLED.
//
// The FSM is DATA: phases are `fsm_phase` nodes; each binds its backend LAW by name (the push/brake/release
// amplitude of the option parameter theta, or the frozen settling policy) and declares its outgoing
// transitions as `on <guard-event> to <phase>;`. Python (hymeko_rl/coin_delivery/coin_carry_fsm.py) binds
// ONLY the named guard predicates + law->action backends and WALKS this graph — the transition topology
// (which phase follows which on which event) is sourced HERE, not duplicated in the executor's if/elif.
//
// Guard events (evaluated by the coin backend on the live sim state):
//   handoff       strict >= 1                    (a valid handoff was reached — from ANY macro phase)
//   abort         safety-abort predicate trips   (irreversible contact loss / divergence — from ANY phase)
//   push_reached  dtz <= PUSH_DTZ                 push drove the coin into the brake band
//   push_timeout  phase steps >= T_push           push duration budget spent
//   brake_centered dtz <= CENTER_TOL              braking pulled the coin into containment
//   brake_slow    speed < 1.5 * SETTLE_VEL        braking removed enough velocity
//   brake_timeout phase steps >= T_brake          brake duration budget spent
//   release_done  phase steps >= T_release        release finished with no handoff -> option completes
//   delivered     K6 dwell satisfied              frozen settling delivered the coin
//   settle_horizon settling ran to the horizon    settling ended without K6
//
// The bundle arc orders the phases; the FIRST phase (PUSH) is the initial state.

coin_carry_option_description {
    @"meta_controller.hymeko";
    using controller.params as cp;
    using controller.phases as ph;
    using controller        as c;
}

coin_carry_option: cp, ph, c
{
    // Commit the push amplitude a_push until the coin enters the brake band or the push budget is spent.
    @PUSH: ph.fsm_phase {
        law push_amplitude;
        on handoff to HANDOFF;
        on abort to ABORTED;
        on push_reached to BRAKE;
        on push_timeout to BRAKE;
    }

    // Commit the brake amplitude a_brake until the coin is centred / slow enough or the brake budget is spent.
    @BRAKE: ph.fsm_phase {
        law brake_amplitude;
        on handoff to HANDOFF;
        on abort to ABORTED;
        on brake_centered to RELEASE;
        on brake_slow to RELEASE;
        on brake_timeout to RELEASE;
    }

    // Commit the release amplitude a_release; if no handoff is reached the macro completes (re-decide).
    @RELEASE: ph.fsm_phase {
        law release_amplitude;
        on handoff to HANDOFF;
        on abort to ABORTED;
        on release_done to COMPLETED;
    }

    // Valid handoff (strict>=1): the FROZEN settling policy pi_0 owns continuation to the K6 decision.
    @HANDOFF: ph.fsm_phase {
        law frozen_settling;
        on delivered to DELIVERED;
        on settle_horizon to SETTLED;
    }

    // Terminal markers (backend law `terminal` is a no-op; these carry the certificate outcome).
    @COMPLETED: ph.fsm_phase { law terminal; }
    @ABORTED:   ph.fsm_phase { law terminal; }
    @DELIVERED: ph.fsm_phase { law terminal; }
    @SETTLED:   ph.fsm_phase { law terminal; }

    // Option parameter theta budgets (the option actor emits a_push/brake/release + these durations).
    @budget: cp.gait {
        t_min 2.0;
        t_max 18.0;
        push_dtz 0.06;
    }

    @controller_spec: c.controller_spec {
        (+ PUSH, + BRAKE, + RELEASE, + HANDOFF, + COMPLETED, + ABORTED, + DELIVERED, + SETTLED, + budget);
    }
}
