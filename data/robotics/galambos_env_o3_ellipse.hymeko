// galambos_env_o3_ellipse.hymeko — OBJ_O3-E: the SMOOTH non-circular SHAPE ablation (Track A2 round family, 2026-08-12).
//
// Identical Galambos scene/task to galambos_env.hymeko; ONLY the manipulated object differs. O3-E is a flat
// ELLIPTICAL prism: semi-axes radius (r_x = 0.025) and radius_y (r_y = 0.016), equal projected area to the
// reference disk (r_x·r_y = 0.0004 = 0.02²) and same thickness ⇒ mass = O0, friction unchanged.
// `compose_planar_scene`'s "ellipse" branch builds a 128-segment flat mesh prism (smooth rim, no corners),
// which — unlike a native MuJoCo `ellipsoid` (it bulges in z ⇒ different volume ⇒ no mass parity) — keeps the
// flat-topped-puck invariant and equal-area mass.
//
// The round family (smooth, orientation-dependent, no corners) complements the N-gon corner family. Fills the
// long-parked roadmap "O3 ellipse" slot. Isolates SHAPE (smooth eccentricity) from size, mass, friction.

galambos_env_description {
    @"meta_env.hymeko";
    using env.params as p;
    using env        as e;
}

galambos_env: p, e
{
    @zone:   p.target_zone { half 0.04; rx_lo -0.05; rx_hi 0.05; ry_lo 0.10; ry_hi 0.18; randomize 1.0; }
    @spawn:  p.coin_spawn  { rx_lo -0.20; rx_hi 0.20; ry_lo 0.05; ry_hi 0.23; clearance 0.03; }
    @bounds: p.workspace   { x_bound 0.40; y_min -0.08; y_max 0.45; }
    @succ:   p.success     { steps 5.0; }

    // O3-E: flat elliptical prism, semi-axes r_x=0.025 / r_y=0.016 (equal area ⇒ mass = O0), aspect 1.56:1.
    @dsk:    p.disk        { shape "ellipse"; family "prism_ellipse"; radius 0.025; radius_y 0.016; half 0.02; damping 2.5; spin_damping 0.8; frictionloss 0.0; }

    @env_spec: e.env_spec {
        (+ zone, + spawn, + bounds, + succ, + dsk);
    }
}
