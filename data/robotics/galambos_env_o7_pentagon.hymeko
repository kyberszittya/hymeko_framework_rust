// galambos_env_o7_pentagon.hymeko — OBJ_O7-P: the 5-corner SHAPE ablation (Track A2 N-gon family, 2026-08-12).
//
// Identical Galambos scene/task to galambos_env.hymeko; ONLY the manipulated object differs. O7-P is a regular
// PENTAGONAL prism (n_sides 5), equal projected area to the reference disk (radius 0.02) and same thickness ⇒
// same mass at the default density, friction unchanged. `compose_planar_scene`'s "ngon" branch derives the
// equal-area circumradius R_eq = sqrt(2*pi*radius^2 / (n*sin(2*pi/n))) ≈ 0.02299 m (footprint ~23.0 mm, between
// the triangle's 31.1 mm and the coin's 20 mm) and builds a convex mesh (density-derived mass/COM/inertia).
//
// Corner-count axis: triangle (3) → pentagon (5) → hexagon (6) → … → circle. Isolates SHAPE (corner count) from
// size, mass, and friction — the same single-axis discipline as O4-S / O6-T.

galambos_env_description {
    @"meta_env.hymeko";
    using env.params as p;
    using env        as e;
}

galambos_env: p, e
{
    @zone:   p.target_zone { half 0.04; rx_lo -0.05; rx_hi 0.05; ry_lo 0.10; ry_hi 0.18; randomize 1.0; }
    @spawn:  p.coin_spawn  { rx_lo -0.20; rx_hi 0.20; ry_lo 0.05; ry_hi 0.23; clearance 0.03; }
    @bounds: p.workspace   { x_bound 0.40; y_min -0.08; y_max 0.45; }
    @succ:   p.success     { steps 5.0; }

    // O7-P: regular pentagonal prism, n_sides 5, equal projected area (radius = equal-area disk radius 0.02),
    // density default ⇒ mass = O0.
    @dsk:    p.disk        { shape "ngon"; family "prism_pentagon"; radius 0.02; n_sides 5.0; half 0.02; damping 2.5; spin_damping 0.8; frictionloss 0.0; }

    @env_spec: e.env_spec {
        (+ zone, + spawn, + bounds, + succ, + dsk);
    }
}
